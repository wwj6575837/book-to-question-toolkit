# 复制本文件为 .env 并填入真实值（.env 已被 git 忽略）
# cp .env.example .env

# DeepSeek（补题、核对市县区、学校梯队、重点标蓝等脚本）
DEEPSEEK_API_KEY=

# 火山方舟 / 豆包（升学就业分析、学校信息校验）
ARK_API_KEY=

# 高德地图（地址反推省市区、学校搜索）
AMAP_API_KEY=

# 语雀（book-to-question skill、yuque_batch）
YUQUE_TOKEN=
YUQUE_REPO=

# 七牛云（与 config.json 中 qiniu.enabled=true 配合使用）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=https://cdn.example.com

# 通用 AI 配置（yuque_batch 等脚本使用）
AI_API_KEY=
AI_API_BASE=https://api.deepseek.com/v1
AI_MODEL=deepseek-v4-flash

# OpenAI 兼容接口（可选）
OPENAI_API_KEY=
OPENAI_BASE_URL=
